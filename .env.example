# Descrieri complete: docs/infrastructure.md

# --- Comune (web + worker) ---
# Local: docker compose (pnpm db:up). Neon: varianta -pooler pentru web, directă pentru worker și migrații.
DATABASE_URL=postgres://lu:lu@localhost:5433/lucruri_utile
APP_URL=http://localhost:3000
SENTRY_DSN=

# --- Auth (web) ---
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe --- restricted key (rk_), diferită pentru web și worker (ADR-010)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Email (worker) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Facturare (worker) --- smartbill | oblio
INVOICING_PROVIDER=
INVOICING_API_KEY=

# --- Worker ---
WORKER_PORT=8080
